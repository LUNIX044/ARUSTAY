rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidRoom(data) {
      return data.roomNumber is string && 
             data.roomNumber.size() > 0 &&
             data.status in ['cleaning', 'done', 'available', 'occupied'] &&
             data.type is string &&
             data.assignedToday is bool &&
             (data.updatedAt == null || data.updatedAt is timestamp) &&
             (!('lastAction' in data) || data.lastAction in ['check_in', 'check_out', 'none', 'reset', 'clean', 'mid_clean']) &&
             (!('staffEmail' in data) || data.staffEmail == null || data.staffEmail is string) &&
             (!('memo' in data) || (data.memo is string && data.memo.size() <= 1000));
    }

    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isVerified() && isValidRoom(request.resource.data);
      allow update: if isVerified() && isValidRoom(request.resource.data);
      allow delete: if isVerified();
    }

    match /test-connection/{docId} {
      allow read: if true;
    }
  }
}
